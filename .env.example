# Copy to .env (gitignored). Auth lives in ~/.databrickscfg via `databricks auth login`,
# never in this file: reference the CLI profile by name only.
DATABRICKS_CONFIG_PROFILE=complaint-radar

# Unity Catalog targets (defaults match CLAUDE.md; override only if needed)
CR_CATALOG=complaint_radar
CR_LANDING_VOLUME=/Volumes/complaint_radar/raw/landing

# CFPB bulk source (verified 2026-09-29, see docs/data_notes.md)
CR_BULK_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip

# Local working directory for downloads and split parts (gitignored)
CR_DATA_DIR=./data
